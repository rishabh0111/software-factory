#!/usr/bin/env node
// tickets-check: validate a run's tickets.md against its format and the spec
// it implements, then list ready, blocked, unknown and hitl tickets and the
// longest remaining dependency chain.
//
// Usage: node tickets-check <tickets.md> [<spec.md>]
// Exit:  0 no errors (warnings allowed), 1 errors, 2 usage or unreadable file

'use strict';

const fs = require('fs');
const path = require('path');

const args = process.argv.slice(2);
if (args.length < 1 || args.length > 2) {
  process.stderr.write('usage: tickets-check <tickets.md> [<spec.md>]\n');
  process.exit(2);
}

function readText(file) {
  try {
    return fs.readFileSync(file, 'utf8');
  } catch (e) {
    process.stderr.write(`cannot read ${file}: ${e.message}\n`);
    process.exit(2);
  }
}

function prepare(text) {
  return text
    .replace(/\r\n?/g, '\n')
    .replace(/<!--[\s\S]*?-->/g, '')
    .split('\n');
}

const errors = [];
const warnings = [];
const error = (m) => errors.push(m);
const warn = (m) => warnings.push(m);

// ---- tickets file ---------------------------------------------------------

const ticketsPath = args[0];
const ticketLines = prepare(readText(ticketsPath));

let specLine = null;
let nextId = null;
let lineLimit = 400;
let estimate = null;
const batchStatus = new Map();
const tickets = [];
let current = null;

for (const line of ticketLines) {
  let m;
  if (specLine === null && (m = /^\s*-\s+\*\*Spec:\*\*\s*(\S+)/.exec(line))) {
    specLine = m[1];
    continue;
  }
  if (nextId === null && (m = /^\s*-\s+\*\*Next id:\*\*\s*T(\d+)\b/.exec(line))) {
    nextId = Number(m[1]);
    continue;
  }
  if ((m = /^\s*-\s+\*\*PR line limit:\*\*\s*(\S*)/.exec(line))) {
    if (/^\d+$/.test(m[1])) lineLimit = Number(m[1]);
    continue;
  }
  if (estimate === null && (m = /^Estimate: prod=(\d+) test=(\d+) batches=(\d+)\s*$/.exec(line))) {
    estimate = { prod: Number(m[1]), test: Number(m[2]), batches: Number(m[3]) };
    continue;
  }
  if (/^\s*\|/.test(line)) {
    const cells = line.trim().replace(/^\|/, '').replace(/\|$/, '').split('|').map((c) => c.trim());
    if (/^PR-\d+$/.test(cells[0] || '') && cells.length >= 4 && /^\S+$/.test(cells[3])) {
      if (!batchStatus.has(cells[0])) batchStatus.set(cells[0], cells[3]);
    }
    continue;
  }
  if (/^##(?!#)/.test(line)) {
    m = /^##\s+(T\d+):/.exec(line);
    if (m) {
      current = { id: m[1], num: Number(m[1].slice(1)), fields: new Map() };
      tickets.push(current);
    } else {
      current = null;
    }
    continue;
  }
  if (current && (m = /^\s*-\s+([a-z][a-z-]*):(.*)$/.exec(line))) {
    if (!current.fields.has(m[1])) current.fields.set(m[1], m[2].trim());
  }
}

const field = (t, name) => (t.fields.has(name) ? t.fields.get(name) : undefined);
const listField = (value) => {
  if (value === undefined || value === '' || /^none\b/i.test(value)) return [];
  return value.split(',').map((s) => s.trim()).filter(Boolean);
};
const statusWord = (t) => {
  const s = field(t, 'status');
  return s === undefined ? '' : s.split(':')[0].trim();
};
const isLive = (t) => statusWord(t) !== 'dropped';
const openText = (v) => v !== undefined && v !== '' && !/^none\b/i.test(v);

// ---- header and IDs -------------------------------------------------------

if (!estimate) error('no "Estimate: prod=<n> test=<n> batches=<n>" line');
if (nextId === null) error('no "- **Next id:** T<n>" line');
if (tickets.length === 0) error('no tickets (expected "## T<n>: <title>" headings)');

const byId = new Map();
for (const t of tickets) {
  if (byId.has(t.id)) error(`${t.id}: duplicate ticket ID`);
  else byId.set(t.id, t);
}
if (nextId !== null && tickets.length > 0) {
  const highest = Math.max(...tickets.map((t) => t.num));
  if (nextId <= highest) error(`Next id T${nextId} is not greater than the highest ticket T${highest}`);
}

// ---- per ticket -----------------------------------------------------------

const ticketsDir = path.dirname(ticketsPath);
const required = ['covers', 'after', 'batch', 'size', 'verify', 'tracker', 'plan'];
const batchNum = (b) => {
  const m = /^PR-(\d+)$/.exec(b || '');
  return m ? Number(m[1]) : null;
};

for (const t of tickets) {
  const status = field(t, 'status');
  if (status === undefined || status === '') {
    error(`${t.id}: missing status`);
  } else if (!/^(todo|in-progress|done)$/.test(status) && !/^(parked|dropped):\s*\S/.test(status)) {
    error(`${t.id}: bad status "${status}" (allowed: todo, in-progress, done, parked: <reason>, dropped: <reason>)`);
  }
  if (!isLive(t)) continue;

  for (const name of required) {
    const v = field(t, name);
    if (v === undefined || v === '') error(`${t.id}: missing ${name}`);
  }

  const plan = field(t, 'plan');
  if (plan && !/^none\b/i.test(plan)) {
    const planPath = plan.split(/\s+/)[0].replace(/^`|`$/g, '');
    if (!fs.existsSync(path.resolve(ticketsDir, planPath))) {
      warn(`${t.id}: plan ${planPath} does not exist yet; write it before build`);
    }
  }

  const batch = field(t, 'batch');
  if (batch && batchNum(batch) === null) error(`${t.id}: batch "${batch}" is not PR-<n>`);

  const risk = field(t, 'risk');
  if (risk === undefined) {
    warn(`${t.id}: no risk line`);
  } else if (!/^(low|medium|high)(:\s*\S.*)?$/.test(risk)) {
    error(`${t.id}: bad risk "${risk}" (allowed: low, medium, high, optionally ": <reason>")`);
  } else if (risk === 'high') {
    error(`${t.id}: risk high needs a reason and an extra check ("high: <reason>")`);
  }

  for (const dep of listField(field(t, 'after'))) {
    if (dep === t.id) {
      error(`${t.id}: after names itself`);
      continue;
    }
    const other = byId.get(dep);
    if (!other) {
      error(`${t.id}: after names ${dep}, which is not a ticket`);
      continue;
    }
    if (!isLive(other)) {
      error(`${t.id}: after names ${dep}, which is dropped`);
      continue;
    }
    const mine = batchNum(batch);
    const theirs = batchNum(field(other, 'batch'));
    if (mine !== null && theirs !== null && theirs > mine) {
      error(`${t.id}: after ${dep}, which is in a later batch (PR-${theirs} > PR-${mine})`);
    }
  }
}

// ---- cycles ---------------------------------------------------------------

{
  const live = tickets.filter((t) => isLive(t) && byId.get(t.id) === t);
  const liveIds = new Set(live.map((t) => t.id));
  const edges = (t) =>
    listField(field(t, 'after')).filter((d) => d !== t.id && liveIds.has(d));
  const state = new Map(); // 1 visiting, 2 done
  const stack = [];
  const visit = (id) => {
    state.set(id, 1);
    stack.push(id);
    for (const dep of edges(byId.get(id))) {
      const s = state.get(dep);
      if (s === 1) {
        const loop = stack.slice(stack.indexOf(dep));
        error(`cycle: ${[...loop, dep].join(' -> ')}`);
      } else if (s === undefined) {
        visit(dep);
      }
    }
    stack.pop();
    state.set(id, 2);
  };
  for (const t of live) if (!state.has(t.id)) visit(t.id);
}

// ---- sizes, batches, estimate ---------------------------------------------

let prodSum = 0;
let testSum = 0;
const perBatch = new Map();
const sizedBatches = new Set();
for (const t of tickets) {
  if (!isLive(t)) continue;
  const size = field(t, 'size');
  if (size === undefined || size === '') continue;
  const m = /^~?(\d+)\s*\(prod\s+~?(\d+),\s*test\s+~?(\d+)\)/.exec(size);
  if (!m) {
    error(`${t.id}: size "${size}" is not "<total> (prod <n>, test <n>)"`);
    continue;
  }
  const [total, prod, test] = [Number(m[1]), Number(m[2]), Number(m[3])];
  if (total !== prod + test) warn(`${t.id}: size total ${total} is not prod + test (${prod + test})`);
  if (prod + test > lineLimit) error(`${t.id}: ${prod + test} lines exceeds the PR line limit ${lineLimit}; split it`);
  prodSum += prod;
  testSum += test;
  const batch = field(t, 'batch') || '';
  perBatch.set(batch, (perBatch.get(batch) || 0) + prod + test);
  sizedBatches.add(batch);
}
for (const [batch, lines] of perBatch) {
  if (lines > lineLimit) error(`${batch || '(no batch)'}: ${lines} lines exceeds the PR line limit ${lineLimit}`);
}
const openBatches = [...sizedBatches].filter((b) => batchStatus.get(b) !== 'shipped').length;
if (estimate && (estimate.prod !== prodSum || estimate.test !== testSum || estimate.batches !== openBatches)) {
  error(
    `Estimate says prod=${estimate.prod} test=${estimate.test} batches=${estimate.batches}; ` +
      `tickets give prod=${prodSum} test=${testSum} batches=${openBatches}`
  );
}

// ---- coverage against the spec --------------------------------------------

const specPath = args[1] !== undefined ? args[1] : specLine;
if (!specPath) {
  error('no spec path (no "- **Spec:**" line and no second argument)');
} else {
  const specLines = prepare(readText(specPath));
  let specId = null;
  for (const line of specLines) {
    const m = /^id:\s*(SPEC-\S*)/.exec(line);
    if (m) {
      specId = m[1];
      break;
    }
  }
  if (!specId) specId = path.basename(specPath).replace(/\.md$/, '');

  const liveCaps = [];
  const retiredCaps = new Set();
  let section = '';
  for (const line of specLines) {
    let m;
    if (/^##(?!#)/.test(line)) {
      section = line.replace(/^##\s*/, '').trim();
      continue;
    }
    if (section === 'Capabilities' && (m = /^###(?!#)\s+(CAP-\d+):/.exec(line))) {
      if (!liveCaps.includes(m[1])) liveCaps.push(m[1]);
    } else if (section === 'Retired' && (m = /^\s*[-*]\s+(CAP-\d+):/.exec(line))) {
      retiredCaps.add(m[1]);
    }
  }
  if (liveCaps.length === 0) error(`${specPath}: no "### CAP-<n>:" headings under "## Capabilities"`);

  const covered = new Set();
  for (const t of tickets) {
    if (!isLive(t)) continue;
    for (const entry of listField(field(t, 'covers'))) {
      const m = /^(SPEC-[^/\s]+)\/(CAP-\d+)$/.exec(entry);
      if (!m) {
        error(`${t.id}: covers "${entry}" is not SPEC-<slug>/CAP-<n>`);
      } else if (m[1] !== specId) {
        error(`${t.id}: covers ${entry}, but the spec is ${specId}`);
      } else if (retiredCaps.has(m[2])) {
        error(`${t.id}: covers ${entry}, which is retired`);
      } else if (!liveCaps.includes(m[2])) {
        error(`${t.id}: covers ${entry}, which is not a live capability`);
      } else {
        covered.add(m[2]);
      }
    }
  }
  for (const cap of liveCaps) {
    if (!covered.has(cap)) error(`${specId}/${cap}: not covered by any live ticket`);
  }
}

// ---- readiness ------------------------------------------------------------

const ready = [];
const blocked = [];
const unknown = [];
const hitl = [];
for (const t of tickets) {
  if (statusWord(t) !== 'todo') continue;
  const unmet = listField(field(t, 'after')).filter((d) => {
    const other = byId.get(d);
    return !other || statusWord(other) !== 'done';
  });
  if (unmet.length > 0) blocked.push(`${t.id} (waiting on ${unmet.join(', ')})`);
  else if (openText(field(t, 'unknown'))) unknown.push(`${t.id} (${field(t, 'unknown')})`);
  else ready.push(`${t.id} [${field(t, 'batch') || '?'}]`);
  if (openText(field(t, 'hitl'))) hitl.push(`${t.id} (${field(t, 'hitl')})`);
}

// ---- longest remaining chain ----------------------------------------------

const remaining = tickets.filter(
  (t) => byId.get(t.id) === t && !['done', 'dropped'].includes(statusWord(t))
);
const remainingIds = new Set(remaining.map((t) => t.id));
const memo = new Map();
const onPath = new Set();
const chainOf = (id) => {
  if (memo.has(id)) return memo.get(id);
  onPath.add(id);
  let best = [];
  for (const dep of listField(field(byId.get(id), 'after'))) {
    if (!remainingIds.has(dep) || onPath.has(dep)) continue;
    const c = chainOf(dep);
    if (c.length > best.length) best = c;
  }
  onPath.delete(id);
  const result = [...best, id];
  memo.set(id, result);
  return result;
};
let longest = [];
for (const t of remaining) {
  const c = chainOf(t.id);
  if (c.length > longest.length) longest = c;
}

// ---- output ---------------------------------------------------------------

const out = [];
for (const e of errors) out.push(`error: ${e}`);
for (const w of warnings) out.push(`warning: ${w}`);
const list = (items, sep) => (items.length ? items.join(sep) : 'none');
out.push(`ready: ${list(ready, ', ')}`);
out.push(`blocked: ${list(blocked, '; ')}`);
out.push(`unknown: ${list(unknown, '; ')}`);
out.push(`hitl: ${list(hitl, '; ')}`);
out.push(`longest remaining chain: ${list(longest, ' -> ')}`);
out.push(`tickets-check errors=${errors.length} warnings=${warnings.length}`);
process.stdout.write(out.join('\n') + '\n');
process.exitCode = errors.length > 0 ? 1 : 0;
